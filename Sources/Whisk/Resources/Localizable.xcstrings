    "Thanks for opening this page >< I hope you enjoy my work! Wishing you happiness and success every day!" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Danke fürs Vorbeischauen! Viel Freude mit WhiskyMac."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thanks for stopping by! I hope you enjoy using WhiskyMac."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Merci de votre visite ! J’espère que WhiskyMac vous plaira."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grazie per la visita! Spero che WhiskyMac ti piaccia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ご覧いただきありがとうございます。WhiskyMacを気に入っていただけたら嬉しいです。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "感谢你愿意打开此页面><希望你喜欢我的创作！祝你天天开心，一切顺利！"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "謝謝你來看看！希望你喜歡我的作品，也祝你事事順心。"
          }
        }
      }
    },
    "The accent color also highlights the selected clipboard card." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Akzentfarbe hebt auch die ausgewählte Zwischenablagekarte hervor."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The accent color also highlights the selected clipboard card."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La couleur d’accentuation met aussi en évidence la carte sélectionnée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il colore di accento evidenzia anche la scheda degli appunti selezionata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択中のカードはアクセントカラーで強調表示されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "强调色也用于当前选中剪贴板卡片的边框。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選取的剪貼板卡片也會以強調顏色標示。"
          }
        }
      }
    },
    "The note stays visible. Copy and paste use the original; previews, editing, dragging and online link previews are blocked while hidden." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Notiz bleibt sichtbar. Beim Kopieren und Einfügen wird der Originalinhalt verwendet. Solange er verborgen ist, sind vollständige Vorschau, Bearbeitung, Ziehen und Linkvorschau gesperrt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The note stays visible. Copy and paste still use the original content. Full previews, editing, dragging, and online link previews are unavailable while the content is hidden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La note reste visible. La copie et le collage utilisent toujours le contenu original. Tant que le contenu est masqué, l’aperçu complet, la modification, le glisser-déposer et les aperçus de liens sont désactivés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La nota resta visibile. Copia e incolla usano ancora il contenuto originale. Finché il contenuto è nascosto, l’anteprima completa, la modifica, il trascinamento e le anteprime dei link non sono disponibili."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メモは表示され、コピーやペーストには元の内容が使われます。内容が非表示の間は、全体のプレビュー、編集、ドラッグ、オンラインでのリンクのプレビューは利用できません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "备注仍会显示。复制、粘贴使用原内容；隐藏时禁用完整预览、编辑、拖拽及在线链接预览。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "備註仍會顯示，拷貝與貼上仍使用原始內容。隱藏時無法完整預覽、編輯、拖移或線上預覽連結。"
          }
        }
      }
    },
    "The original will be removed. Unselected content is not included in the new cards. Undo restores the original." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Originalkarte wird durch die ausgewählten Teile ersetzt. Mit „Rückgängig“ kannst du das Original wiederherstellen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This replaces the original card with the selected parts. You can undo it to restore the original."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La carte originale sera remplacée par les parties sélectionnées. Vous pouvez annuler l’opération pour la restaurer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La scheda originale verrà sostituita dalle parti selezionate. Puoi annullare l’operazione per ripristinare l’originale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "元のカードは選択した部分で置き換えられます。取り消すと元に戻せます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "原卡将被移除，未勾选内容不会包含在新卡中；撤销可恢复原卡。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "原卡片將被移除，未選取的內容不會儲存到新卡片中。可用「還原」取回原卡片。"
          }
        }
      }
    },
    "The overview is a reading aid. Refer to the original text for the complete terms." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Übersicht dient der Orientierung. Die vollständigen Bedingungen stehen im Originaltext."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Read the original text for the complete terms."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet aperçu facilite la lecture. Consultez le texte original pour connaître toutes les conditions."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa panoramica facilita la lettura. Per le condizioni complete, consulta il testo originale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "条件の詳細は原文を参照してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "导览仅供快速了解。完整条款请以原文为准。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "導覽僅供參考。完整條款請見原文。"
          }
        }
      }
    },
    "The panel opens with letters as commands: %@ to search, %@ to move, %@ to paste, %@ to preview, %@ to close." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nutze %@ zum Suchen, %@ zum Navigieren, %@ zum Einfügen, %@ für die Vorschau und %@ zum Schließen des Fensters."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use %@ to search, %@ to move, %@ to paste, %@ to preview, and %@ to close the panel."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans le panneau, utilisez %@ pour rechercher, %@ pour vous déplacer, %@ pour coller, %@ pour afficher un aperçu et %@ pour fermer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nel pannello usa %@ per cercare, %@ per spostarti, %@ per incollare, %@ per l’anteprima e %@ per chiudere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パネル内では%@で検索、%@で移動、%@でペースト、%@でプレビュー、%@で閉じます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "面板打开后，字母键用于执行命令：%@ 搜索，%@ 移动，%@ 粘贴，%@ 预览，%@ 关闭。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在面板中，按 %@ 搜尋、%@ 移動、%@ 貼上、%@ 預覽、%@ 關閉。"
          }
        }
      }
    },
    "The results could not be saved. Your history and draft were kept." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speichern fehlgeschlagen. Verlauf und Entwurf bleiben erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn’t save the results. Your history and draft are still available."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible d’enregistrer. L’historique et le brouillon sont conservés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
