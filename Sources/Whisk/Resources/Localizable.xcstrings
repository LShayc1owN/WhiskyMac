    "LinShay (琳曦) independently maintains WhiskyMac, with a focus on a more comfortable clipboard experience on macOS.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "LinShay (琳曦) independently maintains WhiskyMac, with a focus on a more comfortable clipboard experience on macOS."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "LinShay（琳曦）独立维护 WhiskyMac，希望让 macOS 上的剪贴板使用更顺手。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "LinShay (琳曦) développe et maintient WhiskyMac de façon indépendante pour rendre le presse-papiers plus agréable à utiliser sur macOS."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "LinShay (琳曦) entwickelt und pflegt WhiskyMac unabhängig, damit sich die Zwischenablage unter macOS angenehmer nutzen lässt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "LinShay (琳曦) sviluppa e mantiene WhiskyMac in modo indipendente per rendere più comodo l’uso degli appunti su macOS."
          }
        }
      }
    },
