    },
    "A copied link is looked up once for its title and image. Off, nothing leaves this Mac." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WhiskyMac ruft jeden kopierten Link einmal auf, um Titel und Bild zu laden. Schalte die Option aus, um diese Anfragen zu verhindern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WhiskyMac checks each copied link once for a title and image. Turn this off to stop these requests."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WhiskyMac consulte chaque lien copié une fois pour obtenir son titre et son image. Désactivez cette option pour arrêter ces requêtes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WhiskyMac consulta una volta ogni link copiato per ottenere titolo e immagine. Disattiva l’opzione per interrompere queste richieste."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コピーしたリンクのタイトルと画像を取得するため、WhiskyMacはそのリンクに1回アクセスします。この機能をオフにするとアクセスしません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拷贝链接后，会访问一次该链接以获取标题和图像。关闭后，任何内容都不会离开这台 Mac。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開啟後，每次拷貝連結會向該網站查詢一次標題與圖片。關閉時，這項功能不會對外連線。"
          }
        }
      }
    },
