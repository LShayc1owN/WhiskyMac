            "value": "Condivisione dello schermo"
          }
        }
      }
    },
    "New copies stay in memory briefly. Excluded apps aren’t recorded. Existing history is kept.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New copies stay in memory briefly. Excluded apps aren’t recorded. Existing history is kept."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新拷贝的内容短暂保存在内存中。排除的应用不记录，已有历史保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新拷貝的內容短暫保存在記憶體中。排除的 App 不記錄，既有記錄會保留。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les nouvelles copies restent brièvement en mémoire. Les apps exclues ne sont pas enregistrées. L’historique existant est conservé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neue Kopien bleiben kurz im Arbeitsspeicher. Ausgeschlossene Apps werden nicht erfasst. Der bisherige Verlauf bleibt erhalten."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nuove copie restano brevemente in memoria. Le app escluse non vengono registrate. La cronologia esistente viene conservata."
          }
        }
      }
    },
    "Automatic protection only detects supported Zoom and Teams sharing sessions.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic protection only detects supported Zoom and Teams sharing sessions."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动保护仅检测受支持的 Zoom 和 Teams 共享会话。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自動保護僅偵測支援的 Zoom 和 Teams 共享工作階段。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La protection automatique détecte uniquement les partages Zoom et Teams pris en charge."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der automatische Schutz erkennt nur unterstützte Freigaben in Zoom und Teams."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La protezione automatica rileva solo le sessioni di condivisione supportate di Zoom e Teams."
          }
        }
      }
    },
    "Click the shortcut to change it. Press Esc to cancel.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click the shortcut to change it. Press Esc to cancel."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击快捷键即可修改，按 Esc 取消。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點按快速鍵即可修改，按 Esc 取消。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur le raccourci pour le modifier. Appuyez sur Échap pour annuler."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke auf den Kurzbefehl, um ihn zu ändern. Drücke Esc zum Abbrechen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai clic sulla scorciatoia per cambiarla. Premi Esc per annullare."
          }
        }
      }
    },
    "Lower limits can remove unpinned history immediately.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lower limits can remove unpinned history immediately."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调低限制可能立即删除未固定的历史。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "調低限制可能立即刪除未釘選的記錄。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réduire les limites peut effacer immédiatement les éléments non épinglés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Niedrigere Grenzen können nicht angeheftete Einträge sofort löschen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ridurre i limiti può eliminare subito gli elementi non fissati."
          }
        }
      }
    },
    "Copy something, then open your history.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy something, then open your history."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拷贝一段内容，再打开历史。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拷貝一段內容，再打開記錄。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copiez du contenu, puis ouvrez l’historique."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopiere etwas und öffne dann den Verlauf."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Copia qualcosa, poi apri la cronologia."
          }
        }
      }
    },
    "Try it safely with sample content.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try it safely with sample content."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用示例内容练习，剪贴板和历史不受影响。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用範例內容練習，剪貼簿和記錄不受影響。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exercez-vous avec un exemple sans toucher au presse-papiers."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Übe mit Beispielen, ohne die Zwischenablage zu ändern."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai pratica con esempi senza modificare gli appunti."
          }
        }
      }
    },
    "Manage what stays visible and which clicks are allowed.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Manage what stays visible and which clicks are allowed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "控制可见内容和允许的点击操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "控制可見內容和允許的點按操作。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez les éléments visibles et les clics autorisés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lege fest, was sichtbar bleibt und welche Klicks erlaubt sind."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli cosa resta visibile e quali clic sono consentiti."
          }
        }
      }
    },
    "Copy something new. If it doesn’t appear, check clipboard access, capture status and app exclusions.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy something new. If it doesn’t appear, check clipboard access, capture status and app exclusions."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拷贝新的内容。如果未出现，请检查剪贴板权限、记录状态和排除应用列表。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拷貝新的內容。如果未出現，請檢查剪貼簿權限、記錄狀態和排除 App 列表。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copiez du nouveau contenu. S’il n’apparaît pas, vérifiez l’accès au presse-papiers, la capture et les apps exclues."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopiere etwas Neues. Erscheint es nicht, prüfe den Zugriff auf die Zwischenablage, den Aufnahmestatus und die ausgeschlossenen Apps."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Copia qualcosa di nuovo. Se non appare, verifica l’accesso agli appunti, lo stato della registrazione e le app escluse."
          }
        }
      }
    },
    "Focus a field in the destination app and check Accessibility. You can also copy the card and press ⌘V.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Focus a field in the destination app and check Accessibility. You can also copy the card and press ⌘V."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先选中目标应用的输入框，再检查辅助功能权限。也可以拷贝卡片后按 ⌘V。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "先選取目標 App 的輸入框，再檢查輔助使用權限。也可以拷貝卡片後按 ⌘V。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Placez le curseur dans un champ de l’app cible et vérifiez Accessibilité. Vous pouvez aussi copier la carte et appuyer sur ⌘V."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle ein Feld in der Ziel-App und prüfe die Bedienungshilfen. Alternativ kannst du die Karte kopieren und ⌘V drücken."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleziona un campo nell’app di destinazione e verifica Accessibilità. Puoi anche copiare la scheda e premere ⌘V."
          }
        }
      }
    },
    "Right-click the menu bar icon for settings and pinned items.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Right-click the menu bar icon for settings and pinned items."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "右键点击菜单栏图标，即可打开设置或固定项目。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按右鍵點按選單列圖示，即可打開設定或釘選項目。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites un clic droit sur l’icône de la barre des menus pour ouvrir les réglages ou les éléments épinglés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Per Rechtsklick auf das Menüleistensymbol öffnest du die Einstellungen oder angeheftete Einträge."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai clic destro sull’icona nella barra dei menu per aprire le impostazioni o gli elementi fissati."
          }
        }
      }
    },
    "Use the card menu or a shortcut to continue.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the card menu or a shortcut to continue."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用卡片菜单或快捷键继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用卡片選單或快速鍵繼續。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
