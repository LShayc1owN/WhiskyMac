          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’enregistrer. L’historique et le brouillon sont conservés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichern fehlgeschlagen. Verlauf und Entwurf bleiben erhalten."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvataggio non riuscito. Cronologia e bozza sono state mantenute."
          }
        }
      }
    },
    "The selected results do not fit the history capacity. Select fewer results or increase capacity.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The selected results do not fit the history capacity. Select fewer results or increase capacity."
