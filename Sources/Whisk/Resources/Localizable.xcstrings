    },
    "WhiskyMac uses the GNU GPL version 3 or later. Read the original for the complete terms.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "WhiskyMac uses the GNU GPL version 3 or later. Read the original for the complete terms."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "WhiskyMac 采用 GNU GPL 第 3 版或更新版本。许可涉及使用、分发、修改、源代码提供和担保等事项。完整条款请阅读原文。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "WhiskyMac utilise la GNU GPL version 3 ou ultérieure. La licence traite de l’utilisation, du partage, des modifications, de l’accès au code source et des garanties. Consultez le texte original pour les conditions complètes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "WhiskyMac verwendet die GNU GPL Version 3 oder neuer. Sie regelt Nutzung, Weitergabe, Änderungen, Zugang zum Quellcode und Gewährleistung. Die vollständigen Bedingungen stehen im Originaltext."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "WhiskyMac usa la GNU GPL versione 3 o successiva. La licenza disciplina uso, distribuzione, modifiche, disponibilità del codice sorgente e garanzie. Consulta il testo originale per le condizioni complete."
          }
        }
      }
    },
    "This notice names the original authors, WhiskyMac modifications and third-party materials.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This notice names the original authors, WhiskyMac modifications and third-party materials."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "WhiskyMac 基于 Whisk。本声明列出原作者、WhiskyMac 的修改，以及随附的第三方素材。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "WhiskyMac est basé sur Whisk. Cette notice indique les auteurs d’origine, les modifications de WhiskyMac et les éléments tiers inclus."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "WhiskyMac basiert auf Whisk. Dieser Hinweis nennt die ursprünglichen Urheber, die Änderungen an WhiskyMac und enthaltene Materialien Dritter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "WhiskyMac si basa su Whisk. Questa nota indica gli autori originali, le modifiche di WhiskyMac e i materiali di terze parti inclusi."
          }
        }
      }
    },
    "This document lists third-party artwork and sounds, their licenses and sources.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This document lists third-party artwork and sounds, their licenses and sources."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本文列出随附的第三方图像与音效，以及作者、许可证和来源链接。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce document répertorie les illustrations et sons tiers inclus, leurs auteurs, leurs licences et leurs liens d’origine."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Dokument listet enthaltene Grafiken und Klänge Dritter sowie Urheber, Lizenzen und Quellen auf."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo documento elenca le immagini e i suoni di terze parti inclusi, con autori, licenze e collegamenti alle fonti."
          }
        }
      }
    },
    "The Whisk author grants additional App Store and TestFlight distribution permission.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Whisk author grants additional App Store and TestFlight distribution permission."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Whisk 原版权持有人针对通过 App Store 和 TestFlight 分发授予额外许可，具体条件见原文。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le titulaire des droits d’auteur de Whisk accorde une autorisation supplémentaire pour la distribution via l’App Store et TestFlight, selon les conditions du texte original."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der ursprüngliche Rechteinhaber von Whisk erteilt eine zusätzliche Erlaubnis für die Verbreitung über den App Store und TestFlight. Die Bedingungen stehen im Originaltext."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il titolare originale dei diritti di Whisk concede un permesso aggiuntivo per la distribuzione tramite App Store e TestFlight, alle condizioni indicate nel testo originale."
          }
        }
      }
    },
    "The WhiskyMac author grants additional App Store and TestFlight permission for their work.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The WhiskyMac author grants additional App Store and TestFlight permission for their work."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "WhiskyMac 作者对自己有权许可的贡献，授予通过 App Store 和 TestFlight 分发的额外许可。适用范围和条件见原文。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’auteur de WhiskyMac accorde une autorisation supplémentaire de distribution via l’App Store et TestFlight pour les contributions qu’il est habilité à licencier. Le texte original en précise la portée et les conditions."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Urheber von WhiskyMac erteilt für Beiträge, an denen er die nötigen Rechte hält, eine zusätzliche Erlaubnis zur Verbreitung über den App Store und TestFlight. Geltungsbereich und Bedingungen stehen im Originaltext."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’autore di WhiskyMac concede un permesso aggiuntivo per App Store e TestFlight sui contributi che ha il diritto di concedere in licenza. Ambito e condizioni sono nel testo originale."
          }
        }
      }
    },
