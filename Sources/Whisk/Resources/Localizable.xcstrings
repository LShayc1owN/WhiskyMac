    "Pasting needs Accessibility permission. Without it, use Command-V after copying." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Direktes Einfügen benötigt Zugriff auf die Bedienungshilfen. Du kannst den Eintrag auch kopieren und mit Befehlstaste-V in der Ziel-App einfügen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
