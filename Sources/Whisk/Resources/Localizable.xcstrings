          }
        }
      }
    },
    " that aims to do as much as possible, making input on your Mac easier and simpler.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " that aims to do as much as possible, making input on your Mac easier and simpler."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开发的尽可能做到全能的剪贴板 App，让你的 Mac 输入更轻松简单。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": " qui vise à être aussi complète que possible et à simplifier la saisie sur Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": " und soll die Eingabe auf deinem Mac mit möglichst vielen Funktionen erleichtern."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": " e mira a offrire tutte le funzioni possibili per semplificare la scrittura sul Mac."
          }
        }
      }
    },
