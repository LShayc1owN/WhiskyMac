          "stringUnit": {
            "state": "translated",
            "value": "儲存失敗，歷史記錄與分割草稿已保留。"
          }
        }
      }
    },
    "The selected results do not fit the history capacity. Select fewer results or increase capacity.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The results exceed the history limit. Select fewer or increase the limit."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选结果超出历史容量，请减少选择或提高容量。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les résultats dépassent la capacité. Réduisez la sélection ou augmentez la capacité."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Auswahl passt nicht in den Verlauf. Wähle weniger Ergebnisse aus oder erhöhe die maximale Eintragszahl."
          }
        },
        "it": {
          "stringUnit": {
