    "The accent color also highlights the selected clipboard card.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The accent color also highlights the selected clipboard card."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La couleur d’accentuation met aussi en évidence la carte sélectionnée."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "强调色也用于当前选中剪贴板卡片的边框。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Akzentfarbe hebt auch die ausgewählte Zwischenablagekarte hervor."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il colore di accento evidenzia anche la scheda degli appunti selezionata."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選取的剪貼板卡片也會以強調顏色標示。"
          }
        }
      }
    },
    "The panel opens with letters as commands: %@ to search, %@ to move, %@ to paste, %@ to preview, %@ to close.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use %@ to search, %@ to move, %@ to paste, %@ to preview, and %@ to close the panel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans le panneau, utilisez %@ pour rechercher, %@ pour vous déplacer, %@ pour coller, %@ pour afficher un aperçu et %@ pour fermer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "面板打开后，字母键用于执行命令：%@ 搜索，%@ 移动，%@ 粘贴，%@ 预览，%@ 关闭。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutze %@ zum Suchen, %@ zum Navigieren, %@ zum Einfügen, %@ für die Vorschau und %@ zum Schließen des Fensters."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nel pannello usa %@ per cercare, %@ per spostarti, %@ per incollare, %@ per l’anteprima e %@ per chiudere."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在面板中，按 %@ 搜尋、%@ 移動、%@ 貼上、%@ 預覽、%@ 關閉。"
          }
        }
      }
    },
    "The rich text could not be saved.": {
      "extractionState": "manual",
