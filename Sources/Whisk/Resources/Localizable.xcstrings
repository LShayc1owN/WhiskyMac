    "Accessibility access is needed to check sharing toolbars. Content is hidden as a precaution." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Freigabeerkennung benötigt Zugriff auf die Bedienungshilfen. Der Inhalt wird vorsorglich ausgeblendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sharing detection needs Accessibility permission. Content is hidden as a precaution."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La détection du partage nécessite l’autorisation d’accessibilité. Le contenu est masqué par précaution."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il rilevamento della condivisione richiede l’autorizzazione di Accessibilità. Il contenuto è nascosto per precauzione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画面共有の検出にはアクセシビリティの許可が必要です。念のため、内容を非表示にしています。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "检测共享工具栏需要辅助功能权限。当前已预防性遮盖内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "偵測分享工具列需要「輔助使用」權限。為保護隱私，內容已隱藏。"
          }
        }
      }
    },
