    "One or two characters — a two-character binding like gg runs on the double tap. Esc, Tab, / and 1–9 are fixed.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One or two characters — a two-character binding like gg runs on the double tap. Esc, Tab, / and 1–9 are fixed."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un ou deux caractères — un raccourci à deux caractères comme gg se déclenche au double appui. Échap, Tab, / et 1–9 sont fixes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可设置一个或两个字符。像 gg 这样的双字符绑定需连续按两次。Esc、Tab、/ 和 1–9 为固定按键。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein oder zwei Zeichen. Eine Kombination wie gg wird durch zweimaliges Drücken ausgelöst. Esc, Tab, / und 1–9 sind fest belegt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Uno o due caratteri: una sequenza di due caratteri come gg si attiva premendoli due volte. Esc, Tab, / e 1–9 sono fissi."
          }
        }
      }
    },
