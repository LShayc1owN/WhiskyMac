    "Handoff labels use a system pasteboard marker. Missing markers do not prove a local copy; existing history cannot be reclassified.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Handoff labels rely on a system clipboard marker. An item without the marker might still come from another device. Existing history cannot be reclassified."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les libellés Handoff s’appuient sur un marqueur du presse-papiers. Un élément sans marqueur peut venir d’un autre appareil. L’historique existant ne peut pas être reclassé."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接力标签依据剪贴板系统标记；缺少标记不能证明来自本机，已有历史无法追溯分类。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Handoff-Hinweise beruhen auf einer Markierung der Systemzwischenablage. Auch Einträge ohne Markierung können von einem anderen Gerät stammen. Bestehende Einträge lassen sich nicht neu zuordnen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le etichette Handoff si basano su un indicatore degli appunti di sistema. Anche un elemento senza indicatore può provenire da un altro dispositivo. La cronologia esistente non può essere riclassificata."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "接力標籤根據系統的剪貼板標記判斷。沒有標記不代表項目來自這部 Mac，既有記錄也無法重新分類。"
          }
        }
      }
    },
