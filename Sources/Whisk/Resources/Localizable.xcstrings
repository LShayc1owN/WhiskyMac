    "provides click and switch sounds for clipboard copy feedback." : {
      "comment" : "Continues a sentence that starts with the linked repository name shown before this text.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "liefert Klick- und Schaltergeräusche als Rückmeldung beim Kopieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "provides click and switch sounds for clipboard copy feedback."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "fournit des sons de clic et d’interrupteur pour signaler une copie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "fornisce suoni di clic e di interruttore come conferma della copia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "は、クリップボードにコピーしたときに鳴るクリック音とスイッチ音を提供します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为剪贴板拷贝提供点击声和开关声。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "為剪貼簿拷貝提供點按聲和開關聲。"
          }
        }
      }
    },
    "pt" : {
      "extractionState" : "manual",
      "localizations" : {
