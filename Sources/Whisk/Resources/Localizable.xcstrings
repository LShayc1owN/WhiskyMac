    "Hide cards created before the selected time. Click to use now, or right-click to choose a time. Click again to show hidden cards." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blendet Karten aus, die vor dem gewählten Zeitpunkt erstellt wurden. Ein Klick verwendet die aktuelle Zeit, ein Rechtsklick öffnet die Zeitauswahl. Erneut klicken, um sie wieder anzuzeigen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hide cards older than a chosen time. Click to use the current time or right-click to choose one. Click again to show the hidden cards."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masque les cartes créées avant l’heure choisie. Un clic utilise l’heure actuelle ; un clic droit permet de choisir une heure. Cliquez à nouveau pour annuler le masquage."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nasconde le schede create prima dell’orario scelto. Un clic usa l’ora attuale; un clic destro permette di scegliere un orario. Fai di nuovo clic per annullare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "指定した日時までのカードを非表示にします。クリックで現在の時刻を使い、右クリックで日時を指定できます。もう一度クリックすると、非表示にしたカードが表示されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "隐藏掉于选择时间之前创建的卡片，单击默认选择现在，右键选择具体时间。隐藏后单击即可取消隐藏。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "隱藏所選時間前建立的卡片。按一下以現在為準，或按右鍵選擇時間。再按一下即可顯示隱藏的卡片。"
          }
        }
      }
    },
