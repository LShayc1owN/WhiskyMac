    "No releases are available in this update channel.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No releases are available in this update channel."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个更新频道暂无已发布版本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個更新頻道暫無已發佈版本。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune version n’est disponible sur ce canal."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In diesem Update-Kanal sind keine Versionen verfügbar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna versione è disponibile in questo canale."
          }
        }
      }
    },
    "Your Beta is newer than the latest Release. Waiting for a newer Release.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Beta is newer than the latest Release. Waiting for a newer Release."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前 Beta 比最新的 Release 更新，等下一次正式发布后再升级。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前的 Beta 比最新的 Release 更新，等下一次正式發佈後再升級。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre bêta est plus récente que la dernière version stable. Une prochaine version stable permettra la mise à jour."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Beta ist neuer als die aktuelle stabile Version. Sobald eine neuere stabile Version verfügbar ist, kannst du aktualisieren."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La beta installata è più recente dell’ultima versione stabile. Potrai aggiornare quando uscirà una versione stabile più recente."
          }
        }
      }
    },
