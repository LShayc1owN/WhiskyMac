    "Enter 1–1440 minutes. Shortening the limit also applies to existing sensitive copies; increasing it only affects new copies.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter 1–1440 minutes. A shorter limit also applies to existing items. A longer limit applies only to new items."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可输入 1–1440 分钟。缩短时限也会应用于已有敏感拷贝；延长时限仅影响新拷贝。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez de 1 à 1440 minutes. Réduire la durée s’applique aussi aux copies sensibles existantes ; l’augmenter ne concerne que les nouvelles copies."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib 1–1440 Minuten ein. Eine kürzere Dauer gilt auch für vorhandene Einträge, eine längere nur für neue."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci da 1 a 1440 minuti. Un limite più breve vale anche per gli elementi esistenti. Un limite più lungo vale solo per i nuovi elementi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可輸入 1–1440 分鐘。縮短時限也會套用到既有的敏感內容，延長時限僅影響之後拷貝的內容。"
          }
        }
      }
    },
    "How sensitive access works": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How sensitive items are handled"
          }
        },
        "zh-Hans": {
