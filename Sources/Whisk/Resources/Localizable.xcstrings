    "Optional. Turn on WhiskyMac in Accessibility to paste directly, or copy a card and press ⌘V." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optional. Aktiviere WhiskyMac unter „Bedienungshilfen“, um direkt einzufügen. Du kannst auch eine Karte kopieren und ⌘V drücken."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optional. Turn on WhiskyMac in Accessibility to paste directly, or copy a card and press ⌘V."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Facultatif. Activez WhiskyMac dans Accessibilité pour coller directement. Vous pouvez aussi copier une carte et appuyer sur ⌘V."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Facoltativo. Abilita WhiskyMac in Accessibilità per incollare direttamente. Puoi anche copiare una scheda e premere ⌘V."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "任意。直接ペーストするには「アクセシビリティ」で WhiskyMac を有効にします。カードをコピーして ⌘V を押すこともできます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可选。开启「辅助功能」里的 WhiskyMac 后就能直接粘贴。也可以先拷贝卡片，再按 ⌘V。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選用。在「輔助使用」中開啟 WhiskyMac 後即可直接貼上。也可以先拷貝卡片，再按 ⌘V。"
          }
        }
      }
    },
    "You can continue and grant permissions later." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kannst fortfahren und die Berechtigungen später erteilen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can continue and grant permissions later."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez continuer et accorder les autorisations plus tard."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puoi continuare e concedere le autorizzazioni in seguito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先に進んでから、あとで権限を許可することもできます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可以先继续，稍后再授权。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可以先繼續，稍後再授權。"
          }
        }
      }
    },
    "Rich text keeps its original font sizes." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Formatierter Text behält seine ursprünglichen Schriftgrößen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rich text keeps its original font sizes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le texte enrichi conserve ses tailles de police d’origine."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il testo formattato conserva le dimensioni originali."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リッチテキストには元の文字サイズが使われます。"
          }
