    "Copy a little text in another app, such as TextEdit. Leave the cursor where you want to paste." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopiere einen kurzen Text in einer anderen App, etwa TextEdit. Setze den Cursor an die Stelle, an der du ihn einfügen möchtest."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copy a little text in another app, such as TextEdit. Leave the cursor where you want to paste."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copiez un peu de texte dans une autre app, comme TextEdit. Placez le curseur à l’endroit où vous voulez coller le texte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copia un breve testo in un’altra app, come TextEdit. Posiziona il cursore dove vuoi incollarlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "テキストエディットなどの別のアプリで短いテキストをコピーし、貼り付けたい場所にカーソルを置きます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在其他 App（如「文本编辑」）里拷贝一小段文字，再把光标放到想粘贴的位置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在其他 App（如「文字編輯」）中拷貝一小段文字，再把游標移到想貼上的位置。"
          }
        }
      }
    },
    "Click to copy or paste. When you turn on privacy protection, use the card menu to show the full card or hover to see a small area. Protection triggered by detection keeps cards hidden." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klicke zum Kopieren oder Einfügen. Wenn du den Privatsphärenschutz einschaltest, kannst du die ganze Karte über ihr Menü anzeigen oder beim Verweilen einen kleinen Bereich sehen. Wenn die Erkennung den Schutz auslöst, bleiben Karten ausgeblendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Click to copy or paste. When you turn on privacy protection, use the card menu to show the full card or hover to see a small area. Protection triggered by detection keeps cards hidden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cliquez pour copier ou coller. Lorsque vous activez la protection de la vie privée, le menu de la carte permet de l’afficher en entier et le survol en révèle une petite zone. Lorsque la détection déclenche la protection, les cartes restent masquées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fai clic per copiare o incollare. Quando attivi la protezione della privacy, puoi mostrare l’intera scheda dal suo menu o vederne una piccola parte al passaggio del puntatore. Quando il rilevamento attiva la protezione, le schede restano nascoste."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コピーやペーストはクリックして行います。プライバシー保護をオンにしたときは、カードのメニューから全体を表示したり、ポインタを重ねて一部を表示したりできます。検出によって保護がオンになった場合は、カードは非表示のままです。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拷贝和粘贴需要点击。开启隐私保护后，可通过卡片菜单显示整张卡片，悬停可查看局部。自动识别触发保护时，卡片保持隐藏。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拷貝和貼上需要點按。開啟隱私保護後，可從卡片選單顯示整張卡片，游標停留可查看一小塊區域。自動偵測觸發保護時，卡片會保持隱藏。"
          }
        }
      }
    },
    "Copy something new. If it doesn’t appear, check clipboard access, capture status and app exclusions." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopiere etwas Neues. Erscheint es nicht, prüfe den Zugriff auf die Zwischenablage, den Aufnahmestatus und die ausgeschlossenen Apps."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copy something new. If it doesn’t appear, check clipboard access, capture status and app exclusions."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copiez du nouveau contenu. S’il n’apparaît pas, vérifiez l’accès au presse-papiers, la capture et les apps exclues."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copia qualcosa di nuovo. Se non appare, verifica l’accesso agli appunti, lo stato della registrazione e le app escluse."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しく何かをコピーしてください。表示されない場合は、クリップボードへのアクセス許可、記録の状態、除外設定を確認してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拷贝新的内容。如果未出现，请检查剪贴板权限、记录状态和排除应用列表。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拷貝新的內容。如果未出現，請檢查剪貼簿權限、記錄狀態和排除 App 列表。"
          }
        }
      }
    },
    "Copy something to get started" : {
      "extractionState" : "manual",
