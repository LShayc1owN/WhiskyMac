    "Save new copies to your history. If prompted, choose Allow Paste, then set WhiskyMac to Allow in Paste from Other Apps.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save new copies to your history. If prompted, choose Allow Paste, then set WhiskyMac to Allow in Paste from Other Apps."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把新拷贝的内容存入历史。若系统询问，请允许粘贴，再在「从其他 App 粘贴」中将 WhiskyMac 设为「允许」。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將新拷貝的內容存入記錄。若系統詢問，請允許貼上，再在「從其他 App 貼上」中將 WhiskyMac 設為「允許」。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez vos nouvelles copies à l’historique. Si macOS vous le demande, autorisez le collage, puis sélectionnez Autoriser pour WhiskyMac dans Coller depuis d’autres apps."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichert neue Kopien im Verlauf. Erlaube bei Nachfrage das Einfügen und wähle für WhiskyMac unter „Aus anderen Apps einsetzen“ die Option „Erlauben“."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva le nuove copie nella cronologia. Se richiesto, consenti di incollare, poi scegli Consenti per WhiskyMac in Incolla da altre app."
          }
        }
      }
    },
    "Enable WhiskyMac in Accessibility to paste directly. You can also copy a card and press ⌘V.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable WhiskyMac in Accessibility to paste directly. You can also copy a card and press ⌘V."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在「辅助功能」中允许 WhiskyMac 直接粘贴。也可以拷贝卡片后按 ⌘V。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在「輔助使用」中允許 WhiskyMac 直接貼上。也可以拷貝卡片後按 ⌘V。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez WhiskyMac dans Accessibilité pour coller directement. Vous pouvez aussi copier une carte et appuyer sur ⌘V."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere WhiskyMac unter „Bedienungshilfen“, um direkt einzufügen. Alternativ kannst du eine Karte kopieren und ⌘V drücken."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva WhiskyMac in Accessibilità per incollare direttamente. Puoi anche copiare una scheda e premere ⌘V."
          }
        }
      }
    },
