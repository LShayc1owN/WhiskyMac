    "Show by type or source": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show hidden cards"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示已隐藏类型或来源"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher les cartes masquées"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausgeblendete Karten anzeigen"
          }
        },
        "it": {
