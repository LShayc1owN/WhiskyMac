    "Turn on Privacy Mode before sharing. Revealed or pasted content can still appear on screen.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on Privacy Mode before sharing. Revealed or pasted content can still appear on screen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "共享前打开隐私模式。主动显示或粘贴的内容仍可能出现在屏幕上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "共享前開啟私密模式。主動顯示或貼上的內容仍可能出現在螢幕上。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez le mode Confidentialité avant de partager. Le contenu révélé ou collé peut toujours apparaître à l’écran."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere vor der Freigabe den Datenschutzmodus. Eingeblendete oder eingefügte Inhalte können weiterhin auf dem Bildschirm erscheinen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva la modalità Privacy prima di condividere. I contenuti mostrati o incollati possono comunque apparire sullo schermo."
          }
        }
      }
    },
