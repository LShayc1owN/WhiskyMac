    "Pasting needs Accessibility permission. Without it, use Command-V after copying.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Direct paste requires Accessibility permission. You can still copy the item and press Command-V in the destination app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le collage direct nécessite l’autorisation d’accessibilité. Vous pouvez aussi copier l’élément et appuyer sur Commande-V dans l’app de destination."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "粘贴需要辅助功能权限。未授权时，可先拷贝，再按 Command-V 粘贴。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Direktes Einfügen benötigt Zugriff auf die Bedienungshilfen. Du kannst den Eintrag auch kopieren und mit Befehlstaste-V in der Ziel-App einfügen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per incollare direttamente serve l’autorizzazione di Accessibilità. Puoi comunque copiare l’elemento e premere Comando-V nell’app di destinazione."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "直接貼上需要「輔助使用」權限。你也可以先拷貝，再按 Command-V 貼上。"
          }
        }
      }
    },
