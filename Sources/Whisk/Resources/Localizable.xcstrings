    "Pasting needs Accessibility permission. Without it, use Command-V after copying.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasting needs Accessibility permission. Without it, use Command-V after copying."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le collage nécessite l’autorisation Accessibilité. Sans elle, utilisez Commande-V après la copie."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "粘贴需要辅助功能权限。未授权时，可先拷贝，再按 Command-V 粘贴。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Einfügen ist Bedienungshilfen-Zugriff erforderlich. Ohne diesen kannst du den Inhalt kopieren und mit Befehl-V einfügen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per incollare serve l’autorizzazione Accessibilità. Senza di essa, copia il contenuto e usa Comando-V."
          }
        }
      }
