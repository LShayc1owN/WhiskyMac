    "adds soft clicks, taps, snaps, and bubbles to the copy sound options." : {
      "comment" : "Continues a sentence that starts with the linked repository name shown before this text.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ergänzt die Kopiertöne um sanfte Klick-, Tipp-, Schnapp- und Blasengeräusche."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "adds soft clicks, taps, snaps, and bubbles to the copy sound options."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ajoute aux sons de copie des clics doux, des tapotements, des claquements et des sons de bulles."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "aggiunge clic delicati, tocchi, schiocchi e bolle ai suoni di copia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "は、コピー音にソフトクリック、タップ、スナップ、泡の音を追加します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为拷贝音效新增轻点声、轻敲声、弹响声和气泡声。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "為拷貝音效新增輕點聲、輕敲聲、彈響聲和氣泡聲。"
          }
        }
      }
    },
