            "value": "⌘1…⌘9 paste the matching card directly."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘1…⌘9 collent directement la carte correspondante."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按 ⌘1 至 ⌘9 可直接粘贴对应卡片。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit ⌘1 bis ⌘9 fügst du die entsprechende Karte direkt ein."
          }
        },
        "it": {
