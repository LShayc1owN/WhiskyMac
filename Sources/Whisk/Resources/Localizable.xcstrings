    "Filtering keeps content hidden. Application filters require Show source apps in Privacy Mode.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Filtering keeps content hidden. Application filters require Show source apps in Privacy Mode."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les filtres gardent le contenu masqué. Les filtres d’application nécessitent l’affichage des applications sources en mode confidentialité."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Filtern bleiben Inhalte verborgen. App-Filter erfordern die Anzeige der Quell-Apps im Datenschutzmodus."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "筛选时内容保持遮盖。APP 筛选需要同时开启“在隐私模式下显示来源应用”。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il contenuto resta nascosto durante il filtraggio. I filtri per app richiedono l’opzione Mostra app di origine in modalità privacy."
          }
        }
      }
    },
