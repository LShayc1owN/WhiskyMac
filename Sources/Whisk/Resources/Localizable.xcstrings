        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le collage direct nécessite l’autorisation d’accessibilité. Vous pouvez aussi copier l’élément et appuyer sur Commande-V dans l’app de destination."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
