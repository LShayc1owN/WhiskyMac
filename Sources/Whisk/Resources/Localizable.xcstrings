    "A Handoff marker was observed. The device and source app are unknown.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A Handoff marker was observed. The device and source app are unknown."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un marqueur Handoff a été observé. L’appareil et l’app d’origine sont inconnus."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检测到接力标记，具体设备与来源应用未知。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Handoff-Markierung wurde erkannt. Gerät und Quell-App sind unbekannt."
          }
        }
      }
    },
    "A copied link is looked up once for its title and image. Off, nothing leaves this Mac.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A copied link is looked up once for its title and image. Off, nothing leaves this Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un lien copié est consulté une fois pour son titre et son image. Désactivé, rien ne quitte ce Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拷贝链接后，会访问一次该链接以获取标题和图像。关闭后，任何内容都不会离开这台 Mac。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein kopierter Link wird einmal aufgerufen, um Titel und Bild abzurufen. Ist die Option aus, verlässt dafür nichts diesen Mac."
          }
        }
      }
    },
    "A panel slides up with everything you copied — search it, filter it, arrow through it.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A panel slides up with everything you copied — search it, filter it, arrow through it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un panneau apparaît avec tout ce que vous avez copié — cherchez, filtrez, naviguez aux flèches."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "面板会弹出并展示你拷贝的全部内容，可搜索、筛选或用方向键浏览。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Panel zeigt alles, was du kopiert hast. Durchsuche und filtere den Verlauf oder navigiere mit den Pfeiltasten."
          }
        }
      }
    },
