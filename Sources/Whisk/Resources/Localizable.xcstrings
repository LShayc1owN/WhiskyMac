    "Handoff labels use a system pasteboard marker. Missing markers do not prove a local copy; existing history cannot be reclassified.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Handoff labels use a system pasteboard marker. Missing markers do not prove a local copy; existing history cannot be reclassified."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les libellés Handoff utilisent un marqueur du presse-papiers. Son absence ne prouve pas une copie locale ; l’historique existant ne peut pas être reclassé."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接力标签依据剪贴板系统标记；缺少标记不能证明来自本机，已有历史无法追溯分类。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Handoff-Hinweise beruhen auf einer Systemmarkierung der Zwischenablage. Fehlt die Markierung, ist eine lokale Kopie nicht bestätigt. Vorhandene Einträge können nicht nachträglich zugeordnet werden."
          }
        }
      }
    },
