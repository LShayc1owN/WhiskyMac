    "A card copies, but does not paste" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warum kann ich eine Karte kopieren, aber nicht direkt einfügen?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Why can I copy a card but not paste it directly?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pourquoi puis-je copier une carte sans pouvoir la coller directement ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perché riesco a copiare una scheda ma non a incollarla direttamente?"
          }
        },
