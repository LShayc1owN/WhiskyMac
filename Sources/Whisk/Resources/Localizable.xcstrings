    "Right-click always opens the menu. Follow windows shows the Dock icon for Settings and welcome windows only." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Rechtsklick öffnet das Menü. „Bei geöffneten Fenstern“ zeigt das Dock-Symbol nur an, solange die Einstellungen oder das Willkommensfenster geöffnet sind."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Right-click to open the menu. “When windows are open” shows the Dock icon only while a Settings or welcome window is open."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites un clic droit pour afficher le menu. Avec « Si une fenêtre est ouverte », l’icône du Dock s’affiche uniquement quand les réglages ou le guide de bienvenue sont ouverts."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un clic secondario apre il menu. «Quando ci sono finestre aperte» mostra l’icona nel Dock solo se è aperta la finestra delle impostazioni o di benvenuto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "右クリックでメニューが開きます。「ウインドウを開いているとき」を選ぶと、設定画面かウェルカムガイドを開いている間だけDockアイコンが表示されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "右键始终打开菜单。“跟随窗口”仅在设置、欢迎等普通窗口打开时显示程序坞图标。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按右鍵一定會開啟選單。「跟隨視窗」只在設定或歡迎視窗開啟時顯示 Dock 圖示。"
          }
        }
      }
    },
