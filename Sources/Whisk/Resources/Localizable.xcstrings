    "· With hover filtering, pause the pointer over a tag to show the matching cards. You can still click tags to combine multiple filters." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "· Lass den Zeiger auf einem Tag ruhen, um passende Karten zu sehen. Per Klick kannst du mehrere Filter kombinieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "· Hover over a tag to see matching cards. Click tags to combine filters."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "· Survolez une étiquette pour voir les cartes correspondantes. Cliquez sur plusieurs étiquettes pour combiner les filtres."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "· Lascia il puntatore su un’etichetta per vedere le schede corrispondenti. Fai clic su più etichette per combinare i filtri."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "・タグにポインタを重ねると、一致するカードが表示されます。クリックすると複数のフィルタを組み合わせられます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "· 使用悬浮筛选时，指针悬浮在标签上方片刻时切换至当前筛选下的所有卡片，仍可使用点按手势进行多筛选"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "· 使用停留篩選時，把游標停在標籤上即可顯示符合的卡片。按一下標籤仍可組合多個篩選條件。"
          }
        }
      }
    },
    "%@ is a clipboard history app based on %@." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ verwaltet den Zwischenablageverlauf auf deinem Mac und basiert auf %@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is a clipboard history app based on %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ est une app de gestion de l’historique du presse-papiers basée sur %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ gestisce la cronologia degli appunti del Mac e si basa su %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@は%2$@をベースにしたクリップボード履歴アプリです。"
          }
        },
        "zh-Hans" : {
