    "One or two characters — a two-character binding like gg runs on the double tap. Esc, Tab, / and 1–9 are fixed." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nutze ein oder zwei Zeichen. Für „gg“ drückst du zweimal g. Esc, Tab, / und 1–9 sind reserviert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use one or two characters. For a shortcut like gg, press g twice. Esc, Tab, /, and 1–9 are reserved."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez un ou deux caractères. Pour « gg », appuyez deux fois sur g. Échap, Tab, / et 1–9 sont réservés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa uno o due caratteri. Per «gg» premi g due volte. Esc, Tab, / e 1–9 sono riservati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1文字または2文字で指定します。たとえば「gg」はgキーを2回押します。Esc、Tab、/、1〜9は固定です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可设置一个或两个字符。像 gg 这样的双字符绑定需连续按两次。Esc、Tab、/ 和 1–9 为固定按键。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可指定一個或兩個字元。像 gg 這樣的雙字元組合要連按兩下。Esc、Tab、/ 和 1–9 保留給固定用途。"
          }
        }
      }
    },
