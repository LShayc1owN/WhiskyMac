    "Application observed on this Mac at capture time; source is not verified.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Application observed on this Mac at capture time; source is not verified."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Application observée sur ce Mac lors de la capture ; origine non vérifiée."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "捕获时此 Mac 上的前台应用，实际来源未经验证。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese App war beim Erfassen auf diesem Mac aktiv; die Herkunft wurde nicht bestätigt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "App rilevata su questo Mac al momento dell’acquisizione; l’origine non è verificata."
          }
        }
      }
    },
    "Applies to manual and automatic protection. Search terms and enabled app names are visible on screen and in accessibility. Clipboard content stays hidden; automatic protection still blocks hover reveals.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applies to manual and automatic protection. Search terms and enabled app names are visible on screen and in accessibility. Clipboard content stays hidden; automatic protection still blocks hover reveals."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S’applique aux protections manuelle et automatique. Les termes recherchés et les noms d’apps autorisés restent visibles à l’écran et via Accessibilité. Le contenu reste masqué ; la protection automatique bloque toujours le dévoilement au survol."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "适用于手动和自动保护。搜索词与已允许的来源应用名会显示在屏幕上，并可由辅助功能读取。剪贴板内容仍被遮盖；自动保护仍禁止悬停显现。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gilt für manuellen und automatischen Schutz. Suchbegriffe und Namen aktivierter Apps sind auf dem Bildschirm und für Bedienungshilfen sichtbar. Der Inhalt der Zwischenablage bleibt verborgen; bei automatischem Schutz ist das Aufdecken durch Zeigen weiterhin gesperrt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si applica alla protezione manuale e automatica. I termini di ricerca e i nomi delle app abilitati sono visibili sullo schermo e tramite Accessibilità. Il contenuto degli appunti resta nascosto; la protezione automatica impedisce comunque la rivelazione al passaggio del puntatore."
          }
        }
      }
    },
    "Automatic detection is limited. Use manual protection before important sharing.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic detection is limited. Use manual protection before important sharing."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La détection automatique est limitée. Activez la protection manuelle avant un partage important."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动检测的覆盖范围有限。重要共享前，请开启手动隐私保护。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die automatische Erkennung ist eingeschränkt. Aktiviere vor wichtigen Bildschirmfreigaben den manuellen Schutz."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il rilevamento automatico è limitato. Attiva la protezione manuale prima di condivisioni importanti."
          }
        }
      }
    },
    "Automatic detection is off. Use manual protection before sharing.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic detection is off. Use manual protection before sharing."
          }
        },
        "fr": {
