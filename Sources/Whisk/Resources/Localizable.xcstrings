    "Paste actions stay silent. Automatic sounds are muted during Privacy Mode; sensitive and excluded copies stay silent." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Einfügen wird kein Ton abgespielt. Automatische Töne sind im Privatmodus sowie für vertrauliche Einträge und Kopien aus ausgeschlossenen Apps deaktiviert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pasting is silent. Automatic sounds are off during Privacy Mode and for sensitive items or copies from excluded apps."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le collage est silencieux. Les sons automatiques sont désactivés en mode de confidentialité, pour les éléments sensibles et pour les copies provenant d’apps exclues."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando incolli non viene riprodotto alcun suono. I suoni automatici sono disattivati in modalità privacy, per gli elementi sensibili e per le copie dalle app escluse."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ペースト時は音が鳴りません。プライバシーモード中、機密項目、除外したアプリからのコピーでは、自動で音を鳴らしません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "粘贴操作不播放音效。隐私模式下自动音效静音；敏感及被排除的拷贝保持静音。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "貼上操作不播放音效。隱私模式下自動音效靜音；敏感及被排除的拷貝保持靜音。"
          }
        }
      }
    },
