    "App filters show application names in the filter bar, independently of source labels on cards. Clipboard content stays hidden." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App-Filter zeigen App-Namen in der Filterleiste unabhängig von den Quellenangaben auf Karten. Zwischenablageinhalte bleiben verborgen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App filters can show app names in the filter bar. Source labels on cards have a separate setting. Clipboard content stays hidden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les filtres affichent les noms des applications dans la barre de filtres, indépendamment des sources sur les cartes. Le contenu du presse-papiers reste masqué."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I filtri mostrano i nomi delle app nella barra dei filtri, indipendentemente dalle origini sulle schede. Il contenuto degli appunti rimane nascosto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリフィルタを使うと、フィルタバーにアプリ名を表示できます。カード上のコピー元は別の設定で管理できます。クリップボードの内容は非表示のままです。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App 筛选会在筛选栏显示应用名称，与卡片来源显示独立控制。剪贴板内容仍保持遮盖。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App 篩選會在篩選列顯示 App 名稱，可與卡片上的來源名稱分開設定。剪貼板內容仍會隱藏。"
          }
        }
      }
    },
