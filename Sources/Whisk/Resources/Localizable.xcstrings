    "The original will be removed. Unselected content is not included in the new cards. Undo restores the original.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The original will be removed. Unselected content is not included in the new cards. Undo restores the original."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原卡将被移除，未勾选内容不会包含在新卡中；撤销可恢复原卡。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’original sera supprimé. Le contenu non sélectionné ne sera pas inclus. Annuler restaure l’original."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Original wird entfernt. Nicht ausgewählte Inhalte fehlen in den neuen Karten. Rückgängig stellt das Original wieder her."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’originale verrà rimosso. I contenuti non selezionati non saranno inclusi. Annulla ripristina l’originale."
          }
        }
      }
    },
    "The results could not be saved. Your history and draft were kept.": {
      "extractionState": "manual",
      "localizations": {
