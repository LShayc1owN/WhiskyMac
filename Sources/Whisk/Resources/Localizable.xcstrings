    "WhiskyMac is a native clipboard history app for macOS, based on Whisk.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "WhiskyMac is a native clipboard history app for macOS, based on Whisk."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "WhiskyMac 是基于 Whisk 的 macOS 原生剪贴板历史应用。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "WhiskyMac est une app native d’historique du presse-papiers pour macOS, basée sur Whisk."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "WhiskyMac ist eine native Zwischenablage-App für macOS auf Basis von Whisk."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "WhiskyMac è un’app nativa per la cronologia degli appunti su macOS, basata su Whisk."
          }
        }
      }
    },
