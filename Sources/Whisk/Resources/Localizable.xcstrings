    "Clears all unpinned history, including hidden results. Pinned items are kept. Undo with Command-Z.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clears all unpinned history, including hidden results. Pinned items are kept. Undo with Command-Z."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Efface tout l’historique non épinglé, y compris les résultats masqués. Les éléments épinglés sont conservés. Annulez avec Commande-Z."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清空所有未置顶历史，包含被搜索或筛选隐藏的记录。保留置顶，可按 Command-Z 撤销。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leert den gesamten nicht angehefteten Verlauf, einschließlich ausgeblendeter Ergebnisse. Angeheftete Einträge bleiben erhalten. Mit Befehl-Z widerrufen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancella tutta la cronologia non fissata, inclusi i risultati nascosti. Gli elementi fissati restano. Annulla con Comando-Z."
          }
        }
      }
    },
