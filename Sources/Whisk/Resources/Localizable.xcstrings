    "Return saves, Shift-Return breaks the line, Escape cancels.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press Return to save, Shift-Return for a new line, or Esc to cancel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez sur Entrée pour enregistrer, Maj-Entrée pour insérer un saut de ligne ou Échap pour annuler."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按 Return 存储，Shift-Return 换行，Esc 取消。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drücke Return zum Sichern, Umschalt-Return für eine neue Zeile oder Esc zum Abbrechen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Premi Invio per salvare, Maiuscole-Invio per andare a capo o Esc per annullare."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按 Return 儲存，Shift-Return 換行，Esc 取消。"
          }
        }
      }
    },
