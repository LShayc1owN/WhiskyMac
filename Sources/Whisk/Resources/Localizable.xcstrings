    "More feedback and contact options will be added when their addresses are available.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "More feedback and contact options will be added when their addresses are available."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其他反馈与联系入口将在地址确定后开放。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "D’autres moyens de contact seront ajoutés lorsque leurs adresses seront disponibles."
          }
        },
