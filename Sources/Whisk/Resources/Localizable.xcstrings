    "The original will be removed. Unselected content is not included in the new cards. Undo restores the original.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This replaces the original card with the selected parts. You can undo it to restore the original."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原卡将被移除，未勾选内容不会包含在新卡中；撤销可恢复原卡。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La carte originale sera remplacée par les parties sélectionnées. Vous pouvez annuler l’opération pour la restaurer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Originalkarte wird durch die ausgewählten Teile ersetzt. Mit „Rückgängig“ kannst du das Original wiederherstellen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La scheda originale verrà sostituita dalle parti selezionate. Puoi annullare l’operazione per ripristinare l’originale."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "原卡片將被移除，未選取的內容不會儲存到新卡片中。可用「還原」取回原卡片。"
          }
        }
      }
    },
    "The results could not be saved. Your history and draft were kept.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t save the results. Your history and draft are still available."
          }
        },
        "zh-Hans": {
          "stringUnit": {
