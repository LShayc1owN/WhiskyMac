    "The panel opens with letters as commands: %@ to search, %@ to move, %@ to paste, %@ to preview, %@ to close.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The panel opens with letters as commands: %@ to search, %@ to move, %@ to paste, %@ to preview, %@ to close."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le panneau s'ouvre avec les lettres comme commandes : %@ pour rechercher, %@ pour se déplacer, %@ pour coller, %@ pour prévisualiser, %@ pour fermer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "面板打开后，字母键用于执行命令：%@ 搜索，%@ 移动，%@ 粘贴，%@ 预览，%@ 关闭。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Panel dienen Buchstaben als Befehle: %@ für die Suche, %@ zum Navigieren, %@ zum Einfügen, %@ für die Vorschau und %@ zum Schließen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando apri il pannello, le lettere funzionano come comandi: %@ per cercare, %@ per spostarti, %@ per incollare, %@ per l’anteprima, %@ per chiudere."
          }
        }
      }
    },
