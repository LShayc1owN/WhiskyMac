    "Control what is recorded, displayed and fetched online." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lege fest, was gespeichert, angezeigt und online abgerufen wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Control what is recorded, displayed and fetched online."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contrôlez les copies enregistrées, affichées et les contenus chargés en ligne."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controlla cosa viene registrato, mostrato e recuperato online."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "記録する項目、画面に表示する情報、オンラインで取得する内容を設定します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "管理记录范围、屏幕保护与联网预览。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "管理記錄範圍、螢幕保護與線上預覽。"
          }
        }
      }
    },
    "Copies are kept temporarily, then deleted from WhiskyMac without undo." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vertrauliche Einträge werden nach Ablauf aus WhiskyMac gelöscht und lassen sich nicht wiederherstellen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sensitive items are deleted from WhiskyMac when they expire and can’t be restored."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les copies sont conservées temporairement, puis supprimées de WhiskyMac sans possibilité d’annulation."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli elementi sensibili vengono eliminati da WhiskyMac alla scadenza e non possono essere ripristinati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存期間が過ぎた機密項目はWhiskyMacから削除され、元に戻せません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拷贝仅临时保留，到期从 WhiskyMac 删除，无法撤销找回。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拷貝的內容僅暫時保留，到期會從 WhiskyMac 刪除，無法還原。"
          }
        }
      }
    },
    "Copies from excluded apps are never recorded." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inhalte aus ausgeschlossenen Apps werden nicht gespeichert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copies from excluded apps are never recorded."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les copies provenant des apps exclues ne sont jamais enregistrées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli elementi copiati dalle app escluse non vengono mai registrati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
