    "Accessibility access is needed to check sharing toolbars. Content is hidden as a precaution.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accessibility access is needed to check sharing toolbars. Content is hidden as a precaution."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accès Accessibilité est nécessaire pour vérifier les barres de partage. Le contenu est masqué par précaution."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检测共享工具栏需要辅助功能权限。当前已预防性遮盖内容。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für die Prüfung von Freigabe-Symbolleisten ist Bedienungshilfen-Zugriff erforderlich. Der Inhalt wird vorsorglich ausgeblendet."
          }
        }
      }
    },
