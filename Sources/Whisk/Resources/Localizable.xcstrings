    "Global shortcuts are off until enabled here or recorded.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Global shortcuts stay off until you enable or record them."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les raccourcis globaux restent désactivés tant que vous ne les activez pas ou n’en enregistrez pas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全局快捷键默认关闭，在此启用或录制后即可使用。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Globale Kurzbefehle bleiben ausgeschaltet, bis du sie hier aktivierst oder neu festlegst."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le abbreviazioni globali restano disattivate finché non le attivi o ne registri una."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "全域快速鍵預設關閉。在這裡啟用或錄製快速鍵後即可使用。"
          }
        }
      }
    },
