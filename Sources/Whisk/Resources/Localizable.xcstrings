    "Hover switches to one app after a brief pause. Click still toggles filters; All clears app, type and pinned filters without clearing search.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hover switches to one app after a brief pause. Click still toggles filters; All clears app, type and pinned filters without clearing search."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le survol sélectionne une application après une courte pause. Le clic active ou désactive les filtres ; Tout efface les filtres d’application, de type et d’épinglage sans effacer la recherche."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "悬浮片刻切换至单个 APP。点按仍可切换筛选；“全部”清除 APP、类型和置顶筛选，保留搜索词。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach kurzem Verweilen wird auf eine App gefiltert. Ein Klick schaltet Filter weiterhin um. „Alle“ setzt App-, Typ- und Anheften-Filter zurück, ohne die Suche zu löschen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopo una breve pausa, il passaggio del puntatore filtra una sola app. Il clic continua ad attivare o disattivare i filtri; «Tutti» cancella i filtri per app, tipo ed elementi fissati senza cancellare la ricerca."
          }
        }
      }
    },
