          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez vos nouvelles copies à l’historique. Si macOS vous le demande, autorisez le collage, puis sélectionnez Autoriser pour WhiskyMac dans Coller depuis d’autres apps."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salva le nuove copie nella cronologia. Se richiesto, consenti di incollare, poi scegli Consenti per WhiskyMac in Incolla da altre app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しくコピーした内容を履歴に記録します。確認画面が出たら「ペーストを許可」を選び、「ほかのアプリからペースト」でWhiskyMacを「許可」に設定してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把新拷贝的内容存入历史。若系统询问，请允许粘贴，再在「从其他 App 粘贴」中将 WhiskyMac 设为「允许」。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將新拷貝的內容存入記錄。若系統詢問，請允許貼上，再在「從其他 App 貼上」中將 WhiskyMac 設為「允許」。"
          }
        }
      }
