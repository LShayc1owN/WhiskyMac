    "A Handoff marker was observed. The device and source app are unknown.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A Handoff marker was detected. The device and source app are unknown."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un marqueur Handoff a été détecté. L’appareil et l’app d’origine sont inconnus."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检测到接力标记，具体设备与来源应用未知。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Handoff-Markierung erkannt. Gerät und Quell-App sind unbekannt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rilevato un indicatore Handoff. Il dispositivo e l’app di origine sono sconosciuti."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "偵測到接力標記，無法確認裝置或來源 App。"
          }
        }
      }
    },
    "A copied link is looked up once for its title and image. Off, nothing leaves this Mac.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "WhiskyMac checks each copied link once for a title and image. Turn this off to stop these requests."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "WhiskyMac consulte chaque lien copié une fois pour obtenir son titre et son image. Désactivez cette option pour arrêter ces requêtes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拷贝链接后，会访问一次该链接以获取标题和图像。关闭后，任何内容都不会离开这台 Mac。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "WhiskyMac ruft jeden kopierten Link einmal auf, um Titel und Bild zu laden. Schalte die Option aus, um diese Anfragen zu verhindern."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "WhiskyMac consulta una volta ogni link copiato per ottenere titolo e immagine. Disattiva l’opzione per interrompere queste richieste."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟後，每次拷貝連結會向該網站查詢一次標題與圖片。關閉時，這項功能不會對外連線。"
          }
        }
      }
    },
