    "LinShay (琳曦) independently maintains WhiskyMac, with a focus on a more comfortable clipboard experience on macOS.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "LinShay (琳曦) independently maintains WhiskyMac, a clipboard history app for macOS."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "LinShay（琳曦）独立维护 WhiskyMac，希望让 macOS 上的剪贴板使用更顺手。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "LinShay (琳曦) maintient WhiskyMac, une app indépendante de gestion du presse-papiers pour macOS."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "LinShay (琳曦) pflegt WhiskyMac unabhängig. Die App verwaltet den Zwischenablageverlauf auf dem Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "LinShay (琳曦) mantiene WhiskyMac, un’app indipendente per la cronologia degli appunti su macOS."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "LinShay（琳曦）獨立維護 WhiskyMac，希望讓 macOS 上的剪貼板使用更順手。"
          }
        }
      }
    },
