    "Copy and paste require an explicit click. Full preview and editing stay disabled. Local reveal works only in manual privacy; automatic protection stays masked.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click explicitly to copy or paste. Full previews and editing are disabled. Only manual Privacy Mode can reveal a small area. Automatic protection keeps all content hidden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez pour copier ou coller. L’aperçu complet et la modification sont désactivés. Seule la protection manuelle permet d’afficher une petite zone. La protection automatique masque tout le contenu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke ausdrücklich zum Kopieren oder Einfügen. Vollständige Vorschau und Bearbeitung sind deaktiviert. Ein kleiner Bereich lässt sich nur im manuellen Privatmodus einblenden. Beim automatischen Schutz bleibt alles ausgeblendet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai clic per copiare o incollare. L’anteprima completa e la modifica restano disattivate. Solo in modalità privacy manuale puoi mostrare una piccola area. La protezione automatica mantiene nascosto tutto il contenuto."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "复制和粘贴需主动点击。完整预览与编辑保持禁用；局部显现仅限手动隐私，自动保护继续全遮盖。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "需手動按一下才能拷貝或貼上。完整預覽和編輯仍會停用。只有手動隱私模式可顯示局部內容，自動保護仍會隱藏全部內容。"
          }
        }
      }
    },
